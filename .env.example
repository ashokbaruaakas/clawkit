# =============================================================================
# Core
# =============================================================================
CONTAINER_NAME=clawkit
IMAGE_NAME=ghcr.io/ashokbaruaakas/clawkit
IMAGE_TAG=latest
PORT=18789

# =============================================================================
# OpenClaw
# =============================================================================
OPENCLAW_NO_RESPAWN=1
# REQUIRED - generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Node compile cache directory (persisted via volume)
NODE_COMPILE_CACHE=/home/node/.cache/node-compile-cache

# =============================================================================
# LLM Providers (optional - set at least one)
# =============================================================================
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================================================
# Integrations (optional)
# =============================================================================
# Get your bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Get your integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=

# =============================================================================
# Tailscale (optional - use the docker-compose.tailscale.yml override)
# =============================================================================
# Generate an auth key: https://login.tailscale.com/admin/settings/keys
# Start with: docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d
TS_AUTHKEY=
# Optional: fix the tailnet machine name (defaults to <CONTAINER_NAME>-ts)
TAILSCALE_HOSTNAME=
# Optional: use MagicDNS names (e.g. ssh pi@my-device) instead of 100.x IPs
TS_ACCEPT_DNS=false
# Optional: extra `tailscale up` flags, e.g. --ssh --advertise-exit-node
TS_EXTRA_ARGS=