# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash,zsh}]
indent_size = 2
# shell_variant = posix is used by the foxundermoon.shell-format VS Code extension,
# not a standard EditorConfig property. Editors without the extension ignore it.

[Dockerfile]
indent_size = 4

[Makefile]
indent_style = tab